                }
              }
            }
          }
        }
      }
    },
    "/v1/campaigns/{id}/pacing": {
      "get": {
        "tags": [
          "Tenant — Campaigns"
        ],
        "summary": "Campaign pacing / delivery progress",
        "description": "**Auth:** tenant_admin JWT or tenant API key",
        "parameters": [
          {
            "name": "id",
