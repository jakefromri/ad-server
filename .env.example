# Frontend Supabase auth client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API (Vercel Edge functions) — service role, never exposed to the client.
# No VITE_ prefix on either of these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pepper mixed into device/tenant API key hashing (globalThis.crypto.subtle, Edge-safe)
DEVICE_KEY_HASH_SECRET=

# Public bucket base URL used to reference creative media paths (never validated)
MEDIA_BUCKET_BASE_URL=

# Simulator only — base URL the k6 scenario hits. Dev/staging only, never prod
# for load runs.
K6_TARGET_URL=

# Email for initial superadmin setup
SUPERADMIN_EMAIL=
