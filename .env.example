# Frontend Supabase auth client
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# API (Vercel Edge functions) — service role, never exposed to the client.
# No VITE_ prefix on either of these.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Pepper mixed into device/tenant API key hashing (globalThis.crypto.subtle, Edge-safe)
DEVICE_KEY_HASH_SECRET=

# Public bucket base URL used to reference creative media paths (never validated)
MEDIA_BUCKET_BASE_URL=

# Simulator only — base URL the k6 scenario hits. Dev/staging only, never prod
# for load runs.
K6_TARGET_URL=

# Email for initial superadmin setup
SUPERADMIN_EMAIL=

# Frontend base URL, used to build invite links returned by
# POST /api/admin/tenants (ported from ComposableAuth's APP_URL convention).
# Falls back to http://localhost:5173 in code if unset.
APP_URL=

# Optional — if set, GET /api/cron/expire-reservations requires
# `Authorization: Bearer <CRON_SECRET>`, matching Vercel's documented cron
# convention. If unset, the endpoint is unauthenticated (safe: idempotent,
# only ever touches rows already past their own expiry timestamp).
CRON_SECRET=
